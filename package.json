{
  "name": "asv-agent-desk",
  "productName": "ASV Agent Desk",
  "version": "0.1.0",
  "description": "A local-first macOS desk for orchestrating real Grok Build TUI sessions",
  "main": "./out/main/index.js",
  "author": "ASV Labs",
  "license": "MIT",
  "private": false,
  "homepage": "https://asv-labs.github.io/asv-agent-desk/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ASV-Labs/asv-agent-desk.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "install-electron --no && electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder --mac --arm64",
    "verify:signing": "bash scripts/verify-signing.sh",
    "release": "npm run dist && npm run verify:signing",
    "website:dev": "vite website --host 127.0.0.1",
    "website:build": "vite build website --base=/asv-agent-desk/ --outDir=../website-dist --emptyOutDir",
    "verify:public": "node scripts/verify-public-tree.mjs",
    "audit:media": "scripts/audit-public-media.sh .",
    "ci": "npm run verify:public && npm run audit:media && npm test && npm run typecheck && npm run build && npm run website:build"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@fontsource-variable/instrument-sans": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "exifr": "7.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "tesseract.js": "7.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
